{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://future-engine.dev/contracts/system-design-presentation.v1.schema.json",
  "title": "Future Engine System Design Presentation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "design_id",
    "draft_revision_number",
    "profile_id",
    "design_hash",
    "coordinate_system",
    "instances",
    "relationships",
    "bom",
    "readiness",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": "future-engine.system-design-presentation.v1" },
    "design_id": { "$ref": "#/$defs/id" },
    "draft_revision_number": { "type": "integer", "minimum": 1 },
    "profile_id": { "$ref": "#/$defs/id" },
    "design_hash": { "$ref": "#/$defs/sha256" },
    "coordinate_system": { "$ref": "#/$defs/coordinate_system" },
    "instances": { "type": "array", "items": { "$ref": "#/$defs/instance" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "bom": { "type": "array", "items": { "type": "object" } },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": { "enum": ["ready", "warning", "blocked"] },
        "summary": { "type": "string" }
      }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "vec3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false
    },
    "quat": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false
    },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handedness", "up_axis", "length_unit", "angle_unit", "quaternion_order"],
      "properties": {
        "handedness": { "const": "right" },
        "up_axis": { "const": "z" },
        "length_unit": { "const": "m" },
        "angle_unit": { "const": "rad" },
        "quaternion_order": { "const": "wxyz" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation_m", "rotation_wxyz"],
      "properties": {
        "translation_m": { "$ref": "#/$defs/vec3" },
        "rotation_wxyz": { "$ref": "#/$defs/quat" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "item_key", "kind", "version", "package_digest", "category", "description", "readiness_status"],
      "properties": {
        "release_id": { "$ref": "#/$defs/id" },
        "item_key": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["component", "assembly"] },
        "version": { "type": "string", "minLength": 1 },
        "package_digest": { "$ref": "#/$defs/sha256" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "readiness_status": { "enum": ["ready", "warning", "blocked"] }
      }
    },
    "model": {
      "type": ["object", "null"],
      "required": ["asset_path", "sha256", "size_bytes", "scale_to_m", "model_scale", "inner_rotation_wxyz", "materials"],
      "properties": {
        "asset_path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "scale_to_m": { "type": "number", "exclusiveMinimum": 0 },
        "model_scale": { "$ref": "#/$defs/vec3" },
        "inner_rotation_wxyz": { "$ref": "#/$defs/quat" },
        "materials": { "type": "array", "items": { "type": "object" } }
      }
    },
    "editability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editable", "reason"],
      "properties": {
        "editable": { "type": "boolean" },
        "reason": { "enum": ["anchor", "joint_derived", "generated", "assembly_locked", "live_controlled"] }
      }
    },
    "interface_capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "maximum"],
      "properties": {
        "used": { "type": "integer", "minimum": 0 },
        "maximum": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "unbounded" }] }
      }
    },
    "interface_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "diagnostics"],
      "properties": {
        "status": { "enum": ["reviewed", "draft", "incomplete"] },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_id", "name", "description", "type", "domain", "direction", "compatibility_key", "capacity", "readiness", "connectable", "state", "state_message"],
      "properties": {
        "interface_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "type": { "enum": ["mount", "port"] },
        "domain": { "enum": ["mechanical", "electrical", "signal", "fluid", "thermal", "optical"] },
        "direction": { "enum": ["input", "output", "bidirectional"] },
        "compatibility_key": { "type": "string" },
        "capacity": { "$ref": "#/$defs/interface_capacity" },
        "readiness": { "$ref": "#/$defs/interface_readiness" },
        "connectable": { "type": "boolean" },
        "state": { "enum": ["available", "selected", "compatible", "incompatible", "connected", "capacity_reached", "definition_incomplete"] },
        "state_message": { "type": "string" }
      }
    },
    "resolved_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "value", "unit", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "value": {},
        "unit": { "type": ["string", "null"] },
        "description": { "type": "string" }
      }
    },
    "resolved_configuration": {
      "type": "object",
      "additionalProperties": true,
      "required": ["preset", "parameters"],
      "properties": {
        "preset": { "type": ["string", "null"] },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/resolved_parameter" } }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "name", "world_transform", "release", "model", "editability", "interfaces", "resolved_configuration"],
      "properties": {
        "instance_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "world_transform": { "$ref": "#/$defs/transform" },
        "release": { "$ref": "#/$defs/release" },
        "model": { "$ref": "#/$defs/model" },
        "editability": { "$ref": "#/$defs/editability" },
        "interfaces": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
        "resolved_configuration": { "$ref": "#/$defs/resolved_configuration" }
      }
    },
    "relationship_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "interface_id"],
      "properties": {
        "instance_id": { "$ref": "#/$defs/id" },
        "interface_id": { "type": ["string", "null"] }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "kind", "source", "target", "connection_type", "label", "description", "status", "resolver_status"],
      "properties": {
        "relationship_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["connection", "joint"] },
        "source": { "$ref": "#/$defs/relationship_endpoint" },
        "target": { "$ref": "#/$defs/relationship_endpoint" },
        "connection_type": { "enum": ["mechanical", "electrical", "signal", "fluid", "thermal", "optical"] },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "status": { "enum": ["compatible", "warning", "incompatible", "unverified"] },
        "resolver_status": { "enum": ["resolved", "blocked", "stale", "not_applicable", "unresolved"] }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "instance_id"],
      "properties": {
        "severity": { "enum": ["info", "warning", "error"] },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "instance_id": { "type": ["string", "null"] }
      }
    }
  }
}
